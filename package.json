{
  "name": "cf-friend-tracker",
  "version": "1.2.1",
  "description": "Codeforces 好友关注桌面应用",
  "author": "LLLLLei073",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "build:win": "electron-vite build && electron-builder --win --config",
    "build:portable": "electron-vite build && electron-builder --win dir --config",
    "release": "electron-vite build && electron-builder --win --publish always"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.3.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.24.0",
    "recharts": "^2.12.7",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "typescript": "^5.5.0",
    "vite": "^5.3.0",
    "vitest": "^2.0.0"
  },
  "build": {
    "appId": "com.lei.cffriendtracker",
    "productName": "CF Friend Tracker",
    "directories": {
      "output": "C:/Users/60421/Desktop/cf-release"
    },
    "publish": {
      "provider": "github",
      "owner": "LLLLLei073",
      "repo": "cf-friend-tracker"
    },
    "files": [
      "out/**/*",
      "package.json",
      "node_modules/**/*",
      "!node_modules/**/*.{md,ts,flow,flow.js,coffee,map}",
      "!node_modules/**/test/**",
      "!node_modules/**/tests/**",
      "!node_modules/**/__tests__/**",
      "!node_modules/**/.bin/**",
      "!node_modules/**/README*",
      "!node_modules/**/CHANGELOG*",
      "!node_modules/**/LICENSE*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "signAndEditExecutable": false,
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CF Friend Tracker",
      "differentialPackage": false
    }
  }
}