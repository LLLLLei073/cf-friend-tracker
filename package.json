{
  "name": "cf-friend-tracker",
  "version": "1.4.1",
  "description": "Codeforces 好友关注桌面应用",
  "author": "LLLLLei073",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:wb": "env -u ELECTRON_RUN_AS_NODE -u CODEBUDDY_SESSION_ID -u CLAUDE_SESSION_ID -u NODE_OPTIONS -u HTTP_PROXY -u HTTPS_PROXY -u http_proxy -u https_proxy -u ALL_PROXY -u all_proxy electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.node.check.json && tsc -p tsconfig.web.check.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "build:win": "electron-vite build && electron-builder --win --config",
    "build:portable": "electron-vite build && electron-builder --win dir --config",
    "release": "electron-vite build && electron-builder --win --publish always"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md,html}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "axios": "^1.7.2",
    "cheerio": "^1.0.0",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.3.9",
    "html-to-image": "^1.11.13",
    "mathjax": "^3.2.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.24.0",
    "recharts": "^2.12.7",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-security": "^4.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.67.0",
    "vite": "^5.3.0",
    "vitest": "^2.0.0"
  },
  "build": {
    "appId": "com.lei.cffriendtracker",
    "productName": "CF Friend Tracker",
    "artifactName": "CF-Friend-Tracker-Setup-${version}.${ext}",
    "directories": {
      "output": "C:/Users/60421/Desktop/cf-release"
    },
    "publish": {
      "provider": "github",
      "owner": "LLLLLei073",
      "repo": "cf-friend-tracker"
    },
    "files": [
      "out/**/*",
      "!out/**/*.map",
      "!out/**/*.tsbuildinfo",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false,
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CF Friend Tracker",
      "differentialPackage": false
    }
  }
}
